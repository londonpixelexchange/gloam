def hue_matrix(degrees):
    a = math.radians(degrees)
    c, s = math.cos(a), math.sin(a)
    return (
        (0.213 + c * 0.787 - s * 0.213, 0.715 - c * 0.715 - s * 0.715, 0.072 - c * 0.072 + s * 0.928),
        (0.213 - c * 0.213 + s * 0.143, 0.715 + c * 0.285 + s * 0.140, 0.072 - c * 0.072 - s * 0.283),
        (0.213 - c * 0.213 - s * 0.787, 0.715 - c * 0.715 + s * 0.715, 0.072 + c * 0.928 + s * 0.072),
    )


class Field:

    def __init__(self, w, h, cw, ch, sat=0.5, keep_hue=0.0, vignette=0.0, background=(0, 0, 0)):
        self.w, self.h = w, h
        self.sat = sat
        self.keep_hue = keep_hue
        self.background = background
        self.set_vignette(vignette)
        rx = 1600.0
        ry_rx = (h * ch) / (w * cw)
        off = 0.1 / I / 250 / 512
        uy = ((h - np.arange(h) - 0.5) * 2 / h - 1) * ry_rx
        ux = (np.arange(w) + 0.5) * 2 / w - 1
        ux, uy = np.meshgrid(ux, uy)
        self.r = np.hypot(ux, uy)
        self.squash = np.cos(2 * np.arctan2(uy, ux))
        self.dark = self.darkening(self.r)
        self.phase = np.hypot(ux + off * rx, uy + off * rx * ry_rx) + math.sin(I)
        lo, hi = self.dark.min(), self.dark.max()
        self.mid = (self.dark - lo) / (hi - lo or 1)

    def set_vignette(self, width):
        self.fade = None
        if width:
            # Separate smooth edges give a soft rectangular vignette with rounded corners.
            x = np.linspace(-1, 1, self.w) if self.w > 1 else np.zeros(1)
            y = np.linspace(-1, 1, self.h) if self.h > 1 else np.zeros(1)
            fx = np.clip((1 - np.abs(x)) / width, 0, 1)
            fy = np.clip((1 - np.abs(y)) / width, 0, 1)
            self.fade = ((fy * fy * (3 - 2 * fy))[:, None] *
                         (fx * fx * (3 - 2 * fx))[None, :])[..., None]

    @staticmethod
    def darkening(r):
        d = 0.4 / np.cos(np.sin(r))
        return (np.sin(d * 0.9981 + I * 0.5) / 0.833) ** 2

    def bent(self, shape):
        size, squash, channels = shape
        r = self.r / (size * np.exp(squash * self.squash))
        return np.stack([self.darkening(r / k) for k in channels], -1)

    def colours(self, t, pal, new, sweep, hue, bright, shape=None, numeric=False):
        ph = self.phase + t
        dark = self.dark if shape is None else self.bent(shape)
        c = self._shade(PALETTES[pal], ph, dark)
        if new is not None:
            mix = np.clip((sweep * 1.25 - self.mid) / 0.25, 0, 1)[..., None]
            c = c * (1 - mix) + self._shade(PALETTES[new], ph, dark) * mix
        if hue % 360:
            c = c @ np.array(hue_matrix(hue)).T
        c = np.clip(c * (255 * bright / 100), 0, 255)
        if self.fade is not None:
            c = c * self.fade + np.asarray(self.background) * (1 - self.fade)
        c = np.clip(c + 0.5, 0, 255).astype(np.uint8)
        nums = ((ph % CYCLE) * 100 / CYCLE).astype(int) if numeric else None
        return c, nums

    def _shade(self, par, ph, dark):
        s32, s25 = np.sin(3.2 + ph), np.sin(2.5 + ph)
        c = np.stack((par[0] + s32 * np.cos(ph * 1.5), par[1] + s25 * np.sin(ph * 1.5), par[2] + s25 * np.cos(ph * 3.5)), -1)
        c = c * (dark if dark.ndim == 3 else dark[..., None])
        clipped = np.clip(c, 0, 1)
        if self.keep_hue:
            scaled = np.clip(c / np.maximum(c.max(-1), 1)[..., None], 0, 1)
            clipped = clipped + (scaled - clipped) * self.keep_hue
        c = clipped
        y = c @ np.array((0.2126, 0.7152, 0.0722))
        c = np.clip(y[..., None] + (c - y[..., None]) * self.sat, 0, 1)
        return 0.9 * c + 0.0102


class Renderer:
    """Cache visible cells and write changed runs, or full frames for dense changes."""

    def __init__(self, mode, layout, mini_char):
        self.mode, self.layout, self.mini_char = mode, layout, mini_char
        self.previous = self.previous_status = None
        self.cw, self.ch = LAYOUTS[layout]

    def cells(self, rows, nums):
        # Compare what the terminal displays, including quantized colours and glyphs.
        if self.mode == "ascii":
            glyphs = nums if self.layout == "num" else np.minimum(9, rows.sum(-1, dtype=np.int32) // 77)
            colours = np.full(glyphs.shape, -1, dtype=np.int32)
        else:
            rgb = rows.astype(np.int32)
            if self.mode == "256":
                rgb = (rgb * 10 + 255) // 510
                colours = 16 + rgb[..., 0] * 36 + rgb[..., 1] * 6 + rgb[..., 2]
            else:
                colours = (rgb[..., 0] << 16) | (rgb[..., 1] << 8) | rgb[..., 2]
            glyphs = nums if self.layout == "num" else np.zeros(colours.shape, dtype=np.int32)
        if self.layout == "half" and self.mode != "ascii":
            if len(colours) % 2:
                colours = np.concatenate((colours, colours[-1:]))
            top, bottom = colours[::2], colours[1::2]
            # A space only displays its background; ignore its foreground.
            cells = np.stack((np.where(top == bottom, -1, top), bottom,
                              (top != bottom).astype(np.int32)), -1)
        else:
            default = np.full(colours.shape, -1, dtype=np.int32)
            foreground = self.layout == "num" or self.mini_char != " "
            fg, bg = (colours, default) if foreground else (default, colours)
            cells = np.stack((fg, bg, glyphs), -1)
            cells = np.repeat(cells, max(1, self.ch // 2), axis=0)
        return cells

    def colour_params(self, colour, ground):
        if self.mode == "256":
            return f"{ground};5;{colour}"
        return f"{ground};2;{colour >> 16};{(colour >> 8) & 255};{colour & 255}"

    def render(self, rows, nums, status, cols):
        cells = self.cells(rows, nums)
        full = self.previous is None or self.previous.shape != cells.shape
        changed = None if full else np.any(cells != self.previous, axis=-1)
        # Avoid cursor movements and run bookkeeping when most cells change.
        if not full:
            full = np.count_nonzero(changed) > changed.size * 0.6
        out = []
        fg = bg = -1
        for y in range(len(cells)):
            if full:
                runs = [(0, cells.shape[1])]
            else:
                xs = np.flatnonzero(changed[y])
                if not len(xs):
                    continue
                cuts = np.flatnonzero(np.diff(xs) > 1)
                starts = np.concatenate((xs[:1], xs[cuts + 1]))
                ends = np.concatenate((xs[cuts] + 1, xs[-1:] + 1))
                runs = zip(starts, ends)
            for start, end in runs:
                if not out:
                    out.append(ESC + "[0m")
                out.append(f"{ESC}[{y + 1};{start * self.cw + 1}H")
                # Convert only cells that will actually be sent to the terminal.
                for top, bottom, glyph in cells[y, start:end].tolist():
                    if top != -1 and top != fg and bottom != -1 and bottom != bg:
                        # The common truecolour half-cell path: format one SGR directly.
                        if self.mode == "24bit":
                            out.append(f"{ESC}[38;2;{top >> 16};{(top >> 8) & 255};{top & 255};"
                                       f"48;2;{bottom >> 16};{(bottom >> 8) & 255};{bottom & 255}m")
                        else:
                            out.append(f"{ESC}[38;5;{top};48;5;{bottom}m")
                        fg, bg = top, bottom
                    else:
                        if top != -1 and top != fg:
                            out.append(ESC + "[" + self.colour_params(top, 38) + "m")
                            fg = top
                        if bottom != -1 and bottom != bg:
                            out.append(ESC + "[" + self.colour_params(bottom, 48) + "m")
                            bg = bottom
                    if self.layout == "num":
                        out.append(f"{glyph:>{self.cw}}")
                    elif self.mode == "ascii":
                        out.append(RAMP[glyph] * self.cw)
                    elif self.layout == "half":
                        out.append(HALF if glyph else " ")
                    else:
                        out.append(self.mini_char * self.cw)
        status = status[:cols]
        if full or status != self.previous_status:
            out.append(f"{ESC}[{len(cells) + 1};1H{ESC}[0;2m" + status + ESC + "[0m" + ESC + "[K")
        elif out:
            out.append(ESC + "[0m")
        self.previous, self.previous_status = cells, status
        return "".join(out)


def write_frame(out, frame, clear=False, sync=True):
    """Keep clearing and drawing within one synchronized terminal update."""
    if not frame and not clear:
        return
    begin, end = (ESC + "[?2026h", ESC + "[?2026l") if sync else ("", "")
    out.write(begin + (ESC + "[2J" if clear else "") + frame + end)
    out.flush()


def positive_fps(value):
    fps = float(value)
    if not math.isfinite(fps) or fps <= 0:
        raise argparse.ArgumentTypeError("FPS must be a finite number greater than zero")
    return fps


def vignette_width(value):
    width = float(value)
    if not math.isfinite(width) or not 0 <= width <= 1:
        raise argparse.ArgumentTypeError("vignette width must be between 0 and 1")
    return width


def hex_colour(value):
    if not re.fullmatch(r"#?[0-9a-fA-F]{6}", value):
        raise argparse.ArgumentTypeError("background must be a colour like '#1e2030'")
    value = value.lstrip("#")
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))


def background_reply(sequence):
    match = re.fullmatch(r"\x1b\]11;rgb:([0-9a-fA-F]{1,4})/([0-9a-fA-F]{1,4})/"
                         r"([0-9a-fA-F]{1,4})(?:\x07|\x1b\\)", sequence)
    if match:
        return tuple(round(int(channel, 16) * 255 / (16 ** len(channel) - 1))
                     for channel in match.groups())
    return None


