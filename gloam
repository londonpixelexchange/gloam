    ap.add_argument("--no-now-playing", action="store_true", help="hide the track display (t toggles it)")
    a = ap.parse_args()

    if not shutil.which("ffmpeg"):
        sys.exit("gloam needs ffmpeg (brew install ffmpeg, apt install ffmpeg, ...)")
    sources = expand(a.sources)
    if not sources:
        sys.exit("nothing to play")
    mode = "ascii" if a.nocolour else "256" if a.c256 else "24bit"
    mini_char = (a.mini or " ")[:1]
    layout = ("num" if a.num else "chunky" if a.chunky else "mini" if a.mini is not None
              else "full" if a.full or mode == "ascii" else "half")
    fixed = None
    if a.size:
        try:
            fixed = tuple(max(4, int(n)) for n in a.size.lower().split("x"))
        except ValueError:
            sys.exit("--size wants WxH, like 60x20")
    pal = a.palette or random.choice(NAMES)
    hold, hue, speed = a.hold, a.hue % 360, max(0.1, a.speed)
    bright = max(20, min(200, a.brightness))
    names = {n: v for v, n in REACT_LEVELS}
    try:
        react = names[a.react] if a.react in names else max(0.0, min(10.0, float(a.react)))
    except ValueError:
        sys.exit("--react wants a number from 0 to 10, or one of: " + ", ".join(names))
    sat = max(0.0, min(1.5, a.colour))
    keep_hue = 1 - max(0.0, min(1.0, a.white))
    vignette = a.vignette
    remembered_vignette = vignette or 0.45

    fd = sys.stdin.fileno()
    if not os.isatty(fd):
        sys.exit("gloam needs a terminal")
    try:
        player = Player(not a.no_sound, None if a.latency is None else a.latency / 1000)
    except RuntimeError as e:
        sys.exit(str(e))
    player.vol = max(0, min(200, a.volume)) / 100
    player.ahead = max(0.0, min(1.0, a.ahead / 1000))
    analyser = Analyser()
    idx = 0
    player.play(sources[idx])
    goodbye = None

    saved = termios.tcgetattr(fd)
    out = open(sys.stdout.fileno(), "w", encoding="utf-8", closefd=False)
    try:
        tty.setcbreak(fd)
        out.write(ESC + "[?1049h" + ESC + "[?25l" + ESC + "[2J")
        out.flush()
        field, size = None, None
        tick = 1.0 / a.fps
        nxt = last = time.monotonic()
        t = 0.0
        reaction = Reaction()
        new, sweep = None, 0.0
        change_at = time.monotonic() + CHANGE_EVERY
        note, note_until = "", 0.0
        view = "settings" if a.settings else None
        panel_page, previous_panel = 0, None
        redraw = False
        now_playing = not a.no_now_playing
        reader = Keys()
        background_queried = False
        if a.vignette and a.background is None:
            # OSC 11 is read alongside keys, so unsupported terminals never delay startup.
            out.write(ESC + "]11;?\x07")
            out.flush()
            background_queried = True
        info_until = time.monotonic() + 6
        retry_at = None
        while True:
            cols, rows = fixed or os.get_terminal_size()
            resized = (cols, rows) != size
            if resized:
                size = (cols, rows)
                cw, ch = LAYOUTS[layout]
                field = Field(max(1, cols // cw), max(1, (rows - 1) * 2 // ch), cw, ch, sat, keep_hue,
                              vignette, a.background or reader.background or (0, 0, 0))
                renderer = Renderer(mode, layout, mini_char)
            while True:
                left = nxt - time.monotonic()
                if reader.waiting(time.monotonic()):
                    left = min(left, 0.02)
                r, _, _ = select.select([fd], [], [], max(0.0, left))
                if r:
                    for k in reader.feed(os.read(fd, 1024).decode("latin-1"), time.monotonic()):
                        if k == "q":
                            return
                        if k in "?s" or k == "x" and view:
                            target = "help" if k == "?" else "settings" if k == "s" else None
                            view = None if view == target else target
                            panel_page, previous_panel = 0, None
                            redraw = True
                            renderer.previous = None
                            note_until = 0
                            continue
                        if k == " " and view:
                            panel_page += 1
                            continue
                        if k == "t":
                            now_playing = not now_playing
                            info_until = 0
                            note = f"{'on' if now_playing else 'off'} now playing"
                            note_until = time.monotonic() + 2.5
                            continue
                        if k in "nb":
                            idx = (idx + (1 if k == "n" else -1)) % len(sources)
                            retry_at = None
                            player.play(sources[idx])
                            continue
                        if k in "pP":
                            pal = ((new or NAMES[(NAMES.index(pal) + 1) % len(NAMES)]) if k == "p"
                                   else NAMES[(NAMES.index(pal) - 1) % len(NAMES)])
                            new, sweep = None, 0.0
                            change_at = time.monotonic() + CHANGE_EVERY
                        elif k == "h":
                            hold = not hold
                            change_at = time.monotonic() + CHANGE_EVERY
                        elif k in "v()":
                            if k == "v":
                                vignette = 0.0 if vignette else remembered_vignette
                            else:
                                vignette = round(max(0.0, min(1.0, (vignette or remembered_vignette)
                                                           + (0.05 if k == ")" else -0.05))), 2)
                            if vignette:
                                remembered_vignette = vignette
                                if a.background is None and not background_queried:
                                    out.write(ESC + "]11;?\x07")
                                    out.flush()
                                    background_queried = True
                            field.set_vignette(vignette)
                            value = f"{vignette:.2f}" if vignette else "off"
                            note = f"{value} vignette  (v toggle, ( narrower, ) wider)"
                            note_until = time.monotonic() + 2.5
                            continue
                        elif k in "+=-_":
                            hue = (hue + (15 if k in "+=" else -15)) % 360
                        elif k in "[]":
                            bright = max(20, min(200, bright + (10 if k == "]" else -10)))
                        elif k in "<>,.":
                            speed = max(0.1, min(10.0, speed * (1.25 if k in ">." else 0.8)))
                        elif k in "90":
                            player.vol = max(0.0, min(2.0, round(player.vol + (0.05 if k == "0" else -0.05), 2)))
                            player.muted = False
                        elif k == "m":
                            player.muted = not player.muted
                        elif k in "rR":
                            levels = [v for v, _ in REACT_LEVELS]
                            if k == "r":
                                react = min([v for v in levels if v > react + 1e-9] or [levels[-1]])
                            else:
                                react = max([v for v in levels if v < react - 1e-9] or [levels[0]])
                        elif k == "i":
                            info_until = time.monotonic() + 6
                            continue
                        elif k in "{}":
                            player.ahead = max(0.0, min(1.0, player.ahead + (0.01 if k == "}" else -0.01)))
                        else:
                            continue
                        values = {
                            "palette": f"{pal}" + (" (held)" if hold else ""),
                            "hue": f"{hue:.0f} degrees", "brightness": f"{bright}%",
                            "speed": f"{speed:.2g}x", "volume": f"{player.vol * 100:.0f}%",
                            "mute": "on" if player.muted else "off",
                            "reaction": dict(REACT_LEVELS).get(react, f"{react:.2g}"),
                            "ahead": f"{player.ahead * 1000:.0f}ms",
                        }
                        setting = ("palette" if k in "pPh" else "hue" if k in "+=-_" else
                                   "brightness" if k in "[]" else "speed" if k in "<>,." else
                                   "volume" if k in "90" else "mute" if k == "m" else
                                   "reaction" if k in "rR" else "ahead")
                        note = f"{values[setting]} {setting}"
                        note_until = time.monotonic() + 2.5
                if left <= 0:
                    break
            now = time.monotonic()
            if a.background is None and reader.background is not None:
                field.background = reader.background
            dt, last = min(0.25, now - last), now
            # Never catch up with a burst of frames after a slow render or write.
            nxt = now + tick

            src = sources[idx]
            if retry_at is None and player.finished():
                if is_url(src):
                    retry_at = now + (3 if player.chunks else 10)
                elif idx + 1 < len(sources):
                    idx += 1
                    player.play(sources[idx])
                else:
                    if not player.chunks:
                        goodbye = f"{short_name(src)}: {player.state}"
                    return
            elif retry_at is not None and now >= retry_at:
                retry_at = None
                player.play(src)

            beat = analyser.update(player.samples(), dt, now)
            pace, shape = reaction.update(analyser, beat, dt, react)

            t += STEP * SITE_FPS * dt * speed * pace
            if new is not None:
                sweep += dt / SWEEP
                if sweep >= 1:
                    pal, new = new, None
                    change_at = now + CHANGE_EVERY
            elif not hold and now >= change_at:
                new, sweep = NAMES[(NAMES.index(pal) + 1) % len(NAMES)], 0.0
            colours, nums = field.colours(t, pal, new, sweep, hue, bright, shape,
                                          numeric=layout == "num")

            if now < note_until:
                status = note
            elif now < info_until:
                status = player.info()
            elif not now_playing:
                status = ""
            else:
                label = f"[{idx + 1}/{len(sources)}] " if len(sources) > 1 else ""
                if player.state == "playing":
                    status = f" ♪ {label}{player.display_title() or short_name(src)}"
                    if player.muted:
                        status += "  (muted)"
                else:
                    status = f" {label}{short_name(src)}  {player.state}"
                    if retry_at is not None:
                        status += f"  (trying again in {int(retry_at - now) + 1}s)"
            if view:
                entries = HELP_KEYS if view == "help" else (
                    f"Palette: {pal}" + (f" -> {new}" if new else ""),
                    f"Palette hold: {'on' if hold else 'off'}",
                    f"Vignette: {vignette:.2f}" + (f" (off; saved {remembered_vignette:.2f})" if not vignette else ""),
                    f"Hue: {hue:.0f} degrees", f"Brightness: {bright}%",
                    f"Colour speed: {speed:.2g}x", f"Colour richness: {sat:.2g}",
                    f"Keep colour in highlights: {keep_hue:.2g}",
                    f"Reaction: {dict(REACT_LEVELS).get(react, f'{react:.2g}')} ({react:.2g})",
                    f"Volume: {player.vol * 100:.0f}%", f"Muted: {'yes' if player.muted else 'no'}",
                    f"Picture ahead: {player.ahead * 1000:.0f}ms", f"FPS cap: {a.fps:g}",
                    f"Layout: {layout}", f"Colour mode: {mode}", f"Size: {cols}x{rows}",
                    f"Synchronized updates: {'off' if a.no_sync else 'on'}",
                    f"Sound: {'off' if a.no_sound else 'on'}",
                    f"Now playing display: {'on' if now_playing else 'off'}",
                    f"Vignette background: {field.background}",
                )
                frame = render_panel("Gloam keys (?)" if view == "help" else "Gloam settings (s)",
                                     entries, cols, rows, panel_page, note if now < note_until else "")
                changed_panel = frame != previous_panel or resized or redraw
                previous_panel = frame
                frame = frame if changed_panel else ""
            else:
                frame = renderer.render(colours, nums, status, cols)
            write_frame(out, frame, clear=resized or redraw, sync=not a.no_sync)
            redraw = False
    except KeyboardInterrupt:
        pass
    finally:
        player.close()
        out.write(ESC + "[?2026l" + ESC + "[0m" + ESC + "[?25h" + ESC + "[?1049l")
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        if goodbye:
            print(goodbye, file=sys.stderr)


if __name__ == "__main__":
    main()
