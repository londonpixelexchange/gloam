def use_local_environment():
    """Use the environment made by ./setup without shell activation."""
    root = os.path.dirname(os.path.realpath(__file__))
    environment = os.path.join(root, ".venv")
    python = os.path.join(environment, "bin", "python")
    if os.path.isfile(python) and os.path.realpath(sys.prefix) != os.path.realpath(environment):
        os.execv(python, [python, os.path.realpath(__file__), *sys.argv[1:]])


