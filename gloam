    ap.add_argument("--nocolour", "--nocolor", action="store_true", help="ASCII")
    ap.add_argument("--fps", type=positive_fps, default=30.0, metavar="FPS",
                    help="maximum frames per second (default 30; try 15 for slower terminals)")
    ap.add_argument("--no-sync", action="store_true",
                    help="disable synchronized terminal updates (enabled by default)")
    ap.add_argument("--speed", type=float, default=1.0, help="times the site's speed")
    ap.add_argument("--size", metavar="WxH", help="fixed size in characters")
