#!/usr/bin/env python3
"""One-time dependency setup; no shell activation needed afterward."""
from pathlib import Path
import shutil
import subprocess
import sys
import venv


def main():
    root = Path(__file__).resolve().parent
    environment = root / ".venv"
    python = environment / "bin" / "python"
    try:
        if not python.is_file():
            print("Creating Gloam's local Python environment…", flush=True)
            venv.EnvBuilder(with_pip=True).create(environment)
        subprocess.run([str(python), "-m", "pip", "install", "numpy", "certifi"], check=True)
        # Sound has other backends, so an optional dependency must not block setup.
        result = subprocess.run([str(python), "-m", "pip", "install", "sounddevice"])
        if result.returncode:
            print("Optional sounddevice install failed; Gloam will use a fallback audio player.")
    except (OSError, subprocess.CalledProcessError) as error:
        sys.exit(f"Setup failed: {error}\nFix the error above, then run ./setup again.\n"
                 "On Debian/Ubuntu, creating an environment may require python3-venv.")
    if not shutil.which("ffmpeg"):
        print("Install ffmpeg before playing: brew install ffmpeg (macOS), "
              "or sudo apt install ffmpeg (Debian/Ubuntu).")
    print("Ready. Run ./gloam URL_OR_FILE — no venv activation needed.")


if __name__ == "__main__":
    main()
